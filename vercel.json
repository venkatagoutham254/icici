{
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/gw/(.*)", "dest": "/api/gw/[...path].js" },
    {
      "src": "/session.json",
      "dest": "/public/session.json",
      "headers": { "Cache-Control": "no-store" }
    },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
