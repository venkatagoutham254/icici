# ── Vercel project environment (NOT this file) ───────────────────────────────
# These two are read only by api/gw/[...path].js, server-side, and must be set
# in the Vercel project settings -- never committed and never in session.json.
# The console fetches /api/gw on its own origin; the function attaches the key.
#
#   PROTEAN_GATEWAY_URL=https://protean-gw.aforo.ai
#   ICICI_API_KEY=sk_live_...
#
# Putting ICICI_API_KEY in session.json instead would publish it: that file is
# served to every visitor, so anyone opening the console could read the key and
# bill ICICI for calls they did not make. Injecting it at build time is the same
# exposure -- the browser still receives it.

# Port this console is served on.
CONSOLE_PORT=4000

# Identity ICICI was issued when Protean onboarded them. These land in the JWT
# and are what every metered event is attributed to in Aforo.
ICICI_CUSTOMER_ID=REPLACE_WITH_CUSTOMER_ID
ICICI_KEY_ID=REPLACE_WITH_KEY_ID
PROTEAN_TENANT_ID=protean
TOKEN_ISSUER=https://auth.aforo.ai
