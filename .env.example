# Where Protean's APIs are reached. This is the Protean gateway, never the
# Protean service directly — the gateway is what authenticates ICICI and meters
# the calls, so bypassing it means the usage is never billed.
#
# The localhost default only works when the console is served from the same
# machine as the gateway. Hosted (Vercel, S3, anywhere), "localhost" means the
# VISITOR's machine and reaches nothing — and an https page refuses a plain http
# call as mixed content before it is even sent. Point this at the public https
# gateway for any hosted deployment.
PROTEAN_GATEWAY_URL=http://localhost:8000

# The credential the console sends as X-API-Key on every call — what the
# gateway's key-auth plugin checks. NOT the Aforo ingest key: that one lives on
# the gateway and must never reach the browser.
ICICI_API_KEY=REPLACE_WITH_API_KEY

# Port this console is served on.
CONSOLE_PORT=4000

# Identity ICICI was issued when Protean onboarded them. These land in the JWT
# and are what every metered event is attributed to in Aforo.
ICICI_CUSTOMER_ID=REPLACE_WITH_CUSTOMER_ID
ICICI_KEY_ID=REPLACE_WITH_KEY_ID
PROTEAN_TENANT_ID=protean
TOKEN_ISSUER=https://auth.aforo.ai
